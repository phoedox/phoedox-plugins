{
  "hosts": [
    "ec2.eu-central-1.amazonaws.com"
  ],
  "secrets": {
    "access_key": "AKIADEMO0000EXAMPLE1",
    "secret_key": "demo-secret-key-for-screenshots-only",
    "regions": "eu-central-1"
  },
  "setup": [
    {
      "method": "PATCH",
      "path": "/projects/${project}",
      "body": {
        "name": "Maple Street 12",
        "features": [
          "graph"
        ]
      }
    }
  ],
  "wait": {
    "path": "/projects/${project}/entities",
    "min": 3
  },
  "shots": [
    {
      "name": "entries",
      "path": "/p/${project}/graph",
      "caption": "EC2 instances as VM entries with OS, IP address and vCPUs"
    },
    {
      "name": "instance",
      "path": "/p/${project}/e/aws-i-0a1b2c3d4e5f60001",
      "caption": "An instance's entry: type, state, zone, image and network"
    }
  ]
}
