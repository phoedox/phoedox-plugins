{
  "title": "GitHub repository",
  "type": "object",
  "properties": {
    "url": { "type": "string", "format": "uri", "title": "Address" },
    "description": { "type": "string", "title": "Description" },
    "language": { "type": "string", "title": "Language" },
    "license": { "type": "string", "title": "License" },
    "visibility": { "type": "string", "title": "Visibility", "enum": ["public", "private", "internal"] },
    "stars": { "type": "number", "title": "Stars" },
    "open_issues": { "type": "number", "title": "Open issues" },
    "archived": { "type": "boolean", "title": "Archived" },
    "pushed_at": { "type": "string", "format": "date", "title": "Last push" }
  }
}
