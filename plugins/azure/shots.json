{
  "hosts": [
    "login.microsoftonline.com",
    "management.azure.com"
  ],
  "secrets": {
    "tenant_id": "maple-labs.example.org",
    "client_id": "0b1c2d3e-4f5a-4b6c-8d7e-9f0a1b2c3d4e",
    "client_secret": "demo-client-secret-for-screenshots",
    "subscription_id": "5e7d1c2a-3b4f-4a6e-9c8d-0f1e2d3c4b5a"
  },
  "setup": [
    {
      "method": "PATCH",
      "path": "/projects/${project}",
      "body": {
        "name": "Maple Street 12",
        "features": [
          "graph"
        ]
      }
    }
  ],
  "wait": {
    "path": "/projects/${project}/entities",
    "min": 3
  },
  "shots": [
    {
      "name": "vm",
      "path": "/p/${project}/e/azure-3f6a1c2e-7b4d-4e8a-9c1f-2d3e4f5a6b7c",
      "caption": "A VM's entry: size, region, resource group, image and power state"
    },
    {
      "name": "entries",
      "path": "/p/${project}/graph",
      "caption": "Azure virtual machines as VM entries with their operating system"
    }
  ]
}
