{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Processing activity",
  "description": "An entry of the record of processing activities (Art. 30 GDPR)",
  "type": "object",
  "properties": {
    "purpose": { "type": "string", "title": "Purpose of the processing" },
    "legal_basis": { "type": "string", "title": "Legal basis (Art. 6(1) GDPR)", "enum": ["consent", "contract", "legal_obligation", "vital_interests", "public_task", "legitimate_interests"] },
    "data_categories": { "type": "string", "title": "Categories of personal data" },
    "data_subjects": { "type": "string", "title": "Categories of data subjects" },
    "recipients": { "type": "string", "title": "Categories of recipients" },
    "third_country_transfer": { "type": "boolean", "title": "Transfer to a third country or international organisation" },
    "safeguards": { "type": "string", "title": "Safeguards for the transfer" },
    "retention": { "type": "string", "title": "Time limits for erasure" },
    "toms": { "type": "string", "title": "Technical and organisational measures" },
    "controller_contact": { "type": "string", "title": "Controller (name and contact)" },
    "dpo_contact": { "type": "string", "title": "Data protection officer (contact)" },
    "last_review": { "type": "string", "format": "date", "title": "Last review" }
  }
}
