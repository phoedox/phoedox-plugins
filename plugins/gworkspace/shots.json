{
  "hosts": [
    "oauth2.googleapis.com",
    "admin.googleapis.com"
  ],
  "secrets": {
    "service_account_json": "{\"type\": \"service_account\", \"project_id\": \"maple-labs-demo\", \"private_key_id\": \"demo-key-for-screenshots-only\", \"private_key\": \"${rsaKey}\", \"client_email\": \"phoedox-shots@maple-labs-demo.example.org\", \"client_id\": \"100000000000000000001\", \"token_uri\": \"https://oauth2.googleapis.com/token\"}",
    "admin_email": "alex@example.org"
  },
  "setup": [
    {
      "method": "PATCH",
      "path": "/projects/${project}",
      "body": {
        "name": "Maple Street 12",
        "features": [
          "graph"
        ]
      }
    }
  ],
  "wait": {
    "path": "/projects/${project}/entities",
    "min": 4
  },
  "shots": [
    {
      "name": "entries",
      "path": "/p/${project}/graph",
      "caption": "Chromebooks and phones from Google Workspace as device entries"
    },
    {
      "name": "device",
      "path": "/p/${project}/e/gws-cros-7c2e9a41-5b3d-4f8e-a1c6-0d9b8e7f6a52",
      "caption": "A Chromebook's entry: model, serial, OS version, org unit and asset tag"
    }
  ],
  "_note": "The service account key is generated by the runner for each run (${rsaKey}); it belongs to no Google account."
}
